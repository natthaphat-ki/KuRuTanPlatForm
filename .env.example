# ==== Environment (copy to .env and adjust per environment) ====
ENVIRONMENT=development
DEBUG=true

# --- Database ---
POSTGRES_DB=kurutan
POSTGRES_USER=kurutan
POSTGRES_PASSWORD=kurutan
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://kurutan:kurutan@db:5432/kurutan

# --- Auth ---
SECRET_KEY=CHANGE_ME_IN_PRODUCTION
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- API ---
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# --- Evidence storage (Phase 3 — local disk backend) ---
STORAGE_DIR=storage
MAX_EVIDENCE_FILE_SIZE_BYTES=26214400

# --- AI Service (Phase 6 placeholder) ---
AI_SERVICE_PORT=8001
